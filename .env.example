# Copy to .env and fill in. NEVER commit .env or include it in a
# distributed archive — .gitignore and .dockerignore both exclude it,
# but neither protects a hand-built zip.

# Google Gemini API key for online generation. Bao degrades to offline
# retrieval when this is absent, so it is optional for a local demo.
GEMINI_API_KEY=

# Hugging Face token, used to pull TTS model weights.
HF_TOKEN=

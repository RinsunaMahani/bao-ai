# Model assets tracked with Git LFS. These four files total ~100 MB; GitHub
# warns above 50 MB and hard-rejects any single file above 100 MB, so a
# plain `git add` of the repo will eventually fail without this.
#
# Run `git lfs install` once per machine before the first clone or push,
# otherwise LFS files arrive as small text pointer stubs and the language
# detector silently falls back to the heuristic backend.
*.tflite filter=lfs diff=lfs merge=lfs -text
*.keras  filter=lfs diff=lfs merge=lfs -text
*.pickle filter=lfs diff=lfs merge=lfs -text
tokenizer_config.json filter=lfs diff=lfs merge=lfs -text
